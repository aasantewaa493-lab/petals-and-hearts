# SQLite for local development. For PostgreSQL:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/petals_and_hearts"
DATABASE_URL="file:./dev.db"

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public site origin used in emails, sitemaps, and payment callbacks
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# mock | paystack
# Production must not use mock. Mock never reports a paid order unless the test page confirms it.
PAYMENT_PROVIDER="mock"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Optional. Without this, emails are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="Petals & Hearts <noreply@your-domain.com>"

# First administrator created by the seed script. Change immediately.
ADMIN_BOOTSTRAP_EMAIL="admin@localhost"
ADMIN_BOOTSTRAP_PASSWORD="ChangeMeNow!Admin"
